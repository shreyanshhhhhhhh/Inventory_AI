# SQLite file in the backend working directory. Deploy points this at PostgreSQL.
DATABASE_URL=sqlite:///./inventory.db

# Browser origins allowed to call the API. Match the frontend dev URL.
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123,http://localhost:3000

API_HOST=0.0.0.0
API_PORT=43124

# Required. Use a long random string. This example value is not a secret to deploy.
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
