# SQLite file in the backend working directory. Deploy points this at PostgreSQL.
DATABASE_URL=sqlite:///./inventory.db

# Browser origins allowed to call the API. Match the frontend dev URL.
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123,http://localhost:3000

API_HOST=0.0.0.0
API_PORT=43124

# Required. Use a long random string. This example value is not a secret to deploy.
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# LLM gateway. Tests always use fake. Live providers are gemini, groq, or ollama.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Daily UTC budget per business. A call that would exceed either cap fails.
LLM_BUDGET_REQUESTS_PER_BUSINESS_PER_DAY=200
LLM_BUDGET_TOKENS_PER_BUSINESS_PER_DAY=200000
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Orchestrator. Write steps pause for approval. Tests keep LLM_PROVIDER=fake.
ORCHESTRATOR_MAX_STEPS=12
ORCHESTRATOR_STEP_TIMEOUT_SECONDS=15
ORCHESTRATOR_STEP_RETRIES=1
ORCHESTRATOR_MAX_CONCURRENT_RUNS_PER_USER=2
ORCHESTRATOR_RATE_LIMIT_PER_USER_PER_MINUTE=20
ORCHESTRATOR_CONFIDENCE_MIN=0.7
ORCHESTRATOR_CHAT_HISTORY=6

# Optional cron header for POST /api/v1/jobs/exception-scan. Owner JWT also works.
JOB_SECRET=
# In-process hourly tick that runs enabled shops at their UTC hour. Off in tests.
EXCEPTION_SCAN_SCHEDULER_ENABLED=false

# Purchase guardrail. Auto-approve stays off until the owner sets a threshold in Settings.
PO_MAX_LINE_QUANTITY=1000
PO_MAX_LINES=40
PO_MAX_TOTAL=50000
PO_COST_TOLERANCE_RATIO=0.01

# Supplier email. console logs drafts and never delivers. smtp uses the host below.
EMAIL_SENDER=console
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=true
